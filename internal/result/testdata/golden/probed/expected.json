{
  "meta": {
    "collector": "hyperfine",
    "probes_unavailable": [
      "alloc"
    ]
  },
  "metrics": {
    "cpu_time": {
      "label": "CPU time",
      "unit": "s/op",
      "direction": "lower",
      "method": "difference_per_op",
      "scope": "operation",
      "source": "time_cpu"
    },
    "peak_rss": {
      "label": "Peak RSS",
      "unit": "B",
      "direction": "lower",
      "method": "workload_median",
      "scope": "process_peak",
      "source": "memory_peak_resident"
    },
    "probe.gc": {
      "label": "gc",
      "unit": "count/op",
      "direction": "lower",
      "method": "difference_per_op",
      "scope": "operation",
      "source": "probe.gc"
    },
    "throughput": {
      "label": "Throughput",
      "unit": "op/s",
      "direction": "higher",
      "method": "inverse_wall_time",
      "scope": "operation",
      "source": "time_wall_clock"
    },
    "wall_time": {
      "label": "Wall time",
      "unit": "s/op",
      "direction": "lower",
      "method": "difference_per_op",
      "scope": "operation",
      "source": "time_wall_clock"
    }
  },
