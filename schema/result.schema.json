{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "runtime",
    "workload",
    "metrics",
    "results",
    "meta"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters",
        "warmup",
        "iters",
        "runs"
      ],
      "properties": {
        "parameters": {
          "type": "object"
        },
        "warmup": {
          "type": "integer",
          "minimum": 0
        },
        "iters": {
          "type": "integer",
          "minimum": 1
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "unit",
          "direction",
          "method",
          "scope"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "lower",
              "higher",
              "neutral"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sink",
          "metrics",
          "observations",
          "statistics"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sink": {
            "type": "number"
          },
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "value"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "observations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseline",
                "workload"
              ],
              "properties": {
                "baseline": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "workload": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "statistics": {
            "type": "object"
          }
        }
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jmark.local/schema/result.schema.json",
  "title": "jmark multi-metric result v2"
}
